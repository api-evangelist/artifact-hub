          "info": {
            "name": "Register a new user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://artifacthub.io/api/v1/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Register a new user"
        },
        {
          "info": {
            "name": "Verify user's email address",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://artifacthub.io/api/v1/users/verify-email",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Verify user's email address"
        },
        {
          "info": {
            "name": "Get user's profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://artifacthub.io/api/v1/users/profile",
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY-ID",
              "value": "{{X-API-KEY-ID}}",
              "placement": "header"
            }
          },
          "docs": "Get user's profile"
        },
        {
